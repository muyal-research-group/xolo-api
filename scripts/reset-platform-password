#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_ENV_FILE="${XOLO_COMPOSE_ENV_FILE:-$PROJECT_DIR/deploy/env/compose.env}"

username="${XOLO_PLATFORM_RESET_USERNAME:-}"
password="${XOLO_PLATFORM_RESET_PASSWORD:-}"

if [[ -z "$username" ]]; then
    read -r -p "Platform username [admin]: " username
    username="${username:-admin}"
fi

if [[ -z "$password" ]]; then
    while true; do
        read -r -s -p "New password (minimum 12 characters): " password
        printf "\n"

        if (( ${#password} < 12 )); then
            printf "Password must contain at least 12 characters.\n" >&2
            continue
        fi

        read -r -s -p "Confirm new password: " confirmation
        printf "\n"
        if [[ "$password" != "$confirmation" ]]; then
            printf "Passwords do not match. Try again.\n" >&2
            password=""
            continue
        fi
        break
    done
elif (( ${#password} < 12 )); then
    printf "XOLO_PLATFORM_RESET_PASSWORD must contain at least 12 characters.\n" >&2
    exit 2
fi

cd "$PROJECT_DIR"

XOLO_PLATFORM_RESET_USERNAME="$username" \
XOLO_PLATFORM_RESET_PASSWORD="$password" \
docker compose --env-file "$COMPOSE_ENV_FILE" run --rm --build \
    -e XOLO_PLATFORM_RESET_USERNAME \
    -e XOLO_PLATFORM_RESET_PASSWORD \
    xolo python -m scripts.reset_platform_password
